}

class IReissueLetterRepositoryImpl {
  +findLetters(request: ReissueLetterListRequestDto, queryConsumer: Consumer<JPAQuery<Tuple>>): List<Tuple>
}

interface BulkPrintDataRepository {
  +findByJurorNoAndFormAttributeFormTypeInOrderByCreationDateDesc(jurorNo: String, formCodes: List<String>): List<BulkPrintData>
}

